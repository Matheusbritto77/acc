# Public URL exposed by Dockploy or your reverse proxy.
URL=https://astarot.online

# Shared database used by both account-service and game-server.
CANARY_DB_HOST=YOUR_DB_HOST
CANARY_DB_PORT=3306
CANARY_DB_NAME=YOUR_DB_NAME
CANARY_DB_USER=YOUR_DB_USER
CANARY_DB_PASSWORD=YOUR_DB_PASSWORD

# Game metadata used by the site and generated config.
CANARY_SERVER_NAME=astarOT
CANARY_SERVER_IP=play.astarot.online
CANARY_SERVER_LOCATION=BRA

# Runtime site settings.
SITE_NAME=astarOT
MAINTENANCE=false
DEV_MODE=false
MULTI_WORLD=false
M_COST=1<<16
T_COST=2
PARALLELISM=2
OUTFITS_FOLDER=/resources/images/charactertrade/outfits

# Optional integrations.
PAGSEGURO_EMAIL=
PAGSEGURO_TOKEN=
MERCADOPAGO_TOKEN=
MERCADOPAGO_KEY=
MERCADOPAGO_CLIENTID=
MERCADOPAGO_SECRET=
PAYPAL_CLIENTID=
PAYPAL_SECRET=
REDIS_URL=redis://default:YOUR_REDIS_PASSWORD@209.126.81.68:6379
MAIL_SMTP=smtp://localhost
MAIL_WEB=contact@example.com

# Character Bazaar internal client.
CHAR_BAZAAR_INTERNAL_URL=http://char-bazaar:8089
CHAR_BAZAAR_INTERNAL_TOKEN=change-me
CHAR_BAZAAR_ESCROW_ACCOUNT_ID=2
CHAR_BAZAAR_STEP_UP_TTL_SECONDS=900
CHAR_BAZAAR_RUST_LOG=char_bazaar_service=info,tower_http=info
